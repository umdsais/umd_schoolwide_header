<?php

/**
 * @file
 * Module file for umd_schoolwide_header module.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 *
 * @inheritdoc
 */
function umd_schoolwide_header_help($route_name, RouteMatchInterface $route_match)
{
  switch ($route_name) {
    case 'help.page.umd_schoolwide_header':
      $text = file_get_contents(dirname(__FILE__) . "/README.md");
      if (!\Drupal::moduleHandler()->moduleExists('markdown')) {
        return '<pre>' . $text . '</pre>';
      } else {
        // Use the Markdown filter to render the README.
        $filter_manager = \Drupal::service('plugin.manager.filter');
        $settings = \Drupal::configFactory()->get('markdown.settings')->getRawData();
        $config = ['settings' => $settings];
        $filter = $filter_manager->createInstance('markdown', $config);
        return $filter->process($text, 'en');
      }
  }
  return NULL;
}

/**
 * Implements hook_preprocess_page().
 *
 * Adds js to the page.
 */
function umd_schoolwide_header_preprocess_page(&$variables)
{
  $config = \Drupal::config('system.theme');    
  $default_theme = $config->get('default');

  // Only load library on FE pages, as well as not load if umd_terp theme in use, whuich already loads this lib.
  if (\Drupal::service('router.admin_context')->isAdminRoute()) {
    return;
  } else {
    if($default_theme !== 'umd_terp') {
      $variables['#attached']['library'][] = 'umd_schoolwide_header/umd_header';
    } else {
      dsm('not loaded');
    }
  }
}

function umd_schoolwide_header_page_top(array &$page_top)
{
  if (\Drupal::service('router.admin_context')->isAdminRoute()) {
    return;
  } else {
    $markup = umd_schoolwide_header_build_header();
    $page_top['umd_schoolwide_header'] = [
      '#type' => 'inline_template',
      '#template' => $markup
    ];
  }
}

/**
 * Custom Function.
 *
 * Builds HTML markup for header.
 */
function umd_schoolwide_header_build_header()
{
  $umd_schoolwide_header_fields = \Drupal::config('umd_schoolwide_header.settings');
  // Get config fields, so we can modify markup accordingly.
  $hide_events = $umd_schoolwide_header_fields->get('umd_schoolwide_header.hide_events');
  $hide_news = $umd_schoolwide_header_fields->get('umd_schoolwide_header.hide_news');
  $hide_admissions = $umd_schoolwide_header_fields->get('umd_schoolwide_header.hide_admissions');
  $hide_giving = $umd_schoolwide_header_fields->get('umd_schoolwide_header.hide_giving');
  $hide_search = $umd_schoolwide_header_fields->get('umd_schoolwide_header.hide_search');

  $markup = '<umd-element-navigation-utility';

  // Events
  if ($hide_events !== 1) {
    $markup .= ' data-events="true"';
  } else {
    $markup .= ' data-events="false"';
  }

  // News
  if ($hide_news !== 1) {
    $markup .= ' data-news="true"';
  } else {
    $markup .= ' data-news="false"';
  }

  // Admissions
  if ($hide_admissions !== 1) {
    $markup .= ' data-admissions="true"';
  } else {
    $markup .= ' data-admissions="false"';
  }

  // Giving
  if ($hide_giving !== 1) {
    $markup .= ' data-giving="true"';
  } else {
    $markup .= ' data-giving="false"';
  }

  // Search
  if ($hide_search !== 1) {
    $markup .= ' data-search="true"';
  } 

  // Standardized components
  $markup .= ' data-alert-url="https://umd-main.production.servd.dev/api/v2"';
  $markup .= ' data-layout-lock="full"';
  $markup .= ' data-alert-off="false"';

  // Finalize Markup
  $markup .= '></umd-element-navigation-utility>';

  return $markup;
}